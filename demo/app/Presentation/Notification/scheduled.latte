{block content}
<h1>Scheduled Notifications</h1>

{foreach $activeAttempts as $notificationId => $attempt}
    Notification ID: {$notificationId}<br>
    Attempt ID: {$attempt->id}<br>
    Status: {$attempt->status->value}<br>
    <hr>
{/foreach}

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Event ID</th>
            <th>Type</th>
            <th>Media</th>
            <th>Status</th>
            <th>Text</th>
            <th>Send At</th>
            <th>Created</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        {foreach $notificationMsgs as $notificationMsg}
            <tr n:class="'status-' . $notificationMsg->status->toColor()->value">
                <td class="status-cell">{$notificationMsg->id}</td>
                <td><a n:href="Event:show, id => $notificationMsg->eventId">{$notificationMsg->eventId}</a></td>
                <td>{$notificationMsg->notificationType->value}</td>
                <td>{$notificationMsg->mediaType->value}</td>
                <td><span class="pill">{$notificationMsg->status->value}</span></td>
                <td title="{$notificationMsg->text}">{$notificationMsg->text|truncate:50}</td>
                <td>{$notificationMsg->scheduledAt|date:'d.m.y H:i'}</td>
                <td>{$notificationMsg->createdAt|date:'d.m.y H:i'}</td>
                <td>
                    {if isset($activeAttempts[$notificationMsg->id])}
                        {var $attempt = $activeAttempts[$notificationMsg->id]}
                        {if $attempt->status->supportsCheck()}
                            <a n:href="checkStatus! attemptId => $attempt->id" class="btn btn-normal">Check Status</a>
                        {else}
                            <span class="text-muted">{$attempt->status->value}</span>
                        {/if}
                    {elseif $notificationMsg->status->value === 'scheduled'}
                        <a n:href="withdraw! msgId => $notificationMsg->id" class="btn btn-normal">Withdraw</a>
                        <a n:href="send! msgId => $notificationMsg->id" class="btn btn-important">Send</a>
                    {else}
                        <span class="text-muted">-</span>
                    {/if}
                </td>
            </tr>
        {/foreach}
    </tbody>
</table>

<div class="pagination">
    {if $page > 1}
        <a n:href="scheduled, page => $page - 1">Previous</a>
    {/if}

    <span>Page {$page} of {$lastPage}</span>

    {if $page < $lastPage}
        <a n:href="scheduled, page => $page + 1">Next</a>
    {/if}
</div>

