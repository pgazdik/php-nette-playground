{block content}
<h1>Notifications</h1>

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Event ID</th>
            <th>Type</th>
            <th>Media</th>
            <th>Status</th>
            <th>Content</th>
            <th>Send At</th>
            <th>Created</th>
        </tr>
    </thead>
    <tbody>
        {foreach $notificationMsgs as $notificationMsg}
            <tr n:class="'status-' . $notificationMsg->status->toColor()->value" event-id="{$notificationMsg->eventId}">
                <td class="status-cell">{$notificationMsg->id}</td>
                <td><a n:href="Event:show, id => $notificationMsg->eventId">{$notificationMsg->eventId}</a></td>
                <td>{$notificationMsg->notificationType->value}</td>
                <td>{$notificationMsg->mediaType->value}</td>
                <td><span class="pill">{$notificationMsg->status->value}</span></td>
                <td>
                    {if $notificationMsg->mediaType->isText()}
                        <span title="{$notificationMsg->text}">{$notificationMsg->text|truncate:50}</span>
                    {elseif $notificationMsg->mediaType->isImage()}
                        <img src="{link Notification:serveImageByPath, path => $notificationMsg->filePath}"
                                style="max-height: 40px; border: 1px solid #ccc; cursor: pointer;"
                                onclick="showFullImage(this.src)" 
                                alt="Click to view full size"
                                title="Click to view full size">
                    {/if}
                </td>
                <td>{$notificationMsg->scheduledAt|date:'d.m.y H:i'}</td>
                <td>{$notificationMsg->createdAt|date:'d.m.y H:i'}</td>
            </tr>
        {/foreach}
    </tbody>
</table>

<div class="pagination">
    {if $page > 1}
        <a n:href="default, page => $page - 1">Previous</a>
    {/if}

    <span>Page {$page} of {$lastPage}</span>

    {if $page < $lastPage}
        <a n:href="default, page => $page + 1">Next</a>
    {/if}
</div>