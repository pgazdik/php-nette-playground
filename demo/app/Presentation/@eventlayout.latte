<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ifset title}{include title|stripHtml} | {/ifset}Notifications</title>
    <link rel="stylesheet" href="{$basePath}/cssjs/events.css">
    <script src="{$basePath}/cssjs/modal-image.js"></script>
    <link rel="stylesheet" href="{$basePath}/cssjs/modal-image.css">
    <style>
        body, html {
            margin: 0;
            font-family: Arial, sans-serif;
            height: 100%;
        }

        /* Top Menu Styling */
        .navbar {
            background-color: #008080; /* Dark Teal */
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            position: sticky;
            top: 0;
            z-index: 1001;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 4px;
            display: flex; /* Allow badge to sit nicely */
            align-items: center;
        }

        /* The Highlighted Item */
        .navbar a.active {
            background-color: #4db6ac; /* Lighter teal highlight */
            font-weight: bold;
        }

        /* Hover effect for non-active links */
        .navbar a:hover:not(.active) {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .badge {
            background-color: var(--gold-within-teal);
            color: white;
            border-radius: 50%;
            padding: 4px;
            margin-left: 8px;
            font-size: 11px;
            font-weight: bold;
            line-height: 1;
            min-width: 12px;
            text-align: center;
        }

        /* Main Content Styling */
        .content {
            background-color: #F0F0EB;
            min-height: calc(100vh - 50px); 
            padding: 0 30px 30px 30px;
            box-sizing: border-box;
            overflow-y: hidden;
        }

        .flash {
            padding: 10px;
            margin-top: 10px;
            margin-bottom: 10px;
            border-radius: 4px;
        }
        .flash.msg_success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .flash.msg_error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .flash.msg_warning { background: #fff3cd; color: #856404; border: 1px solid #ffeaa7; }
    </style>
</head>

<body>
    <nav class="navbar">
        <a n:href=":Event:default" n:class="$presenter->isLinkCurrent(':Event:default') ? active">Events</a>
        <a n:href=":Notification:toApprove" n:class="$presenter->isLinkCurrent(':Notification:toApprove') ? active">
            To Approve
            {if isset($countToApprove) && $countToApprove > 0}
                <span class="badge">{$countToApprove}</span>
            {/if}
        </a>
        <a n:href=":Notification:scheduled" n:class="$presenter->isLinkCurrent(':Notification:scheduled') ? active">Scheduled</a>
        <a n:href=":Notification:failed" n:class="$presenter->isLinkCurrent(':Notification:failed') ? active">Failed</a>
        <a n:href=":Notification:default" n:class="$presenter->isLinkCurrent(':Notification:default') ? active">All Notifications</a>
        
        <a href="#" onclick="toggleStatusPopup(event)" style="margin-left: auto;">Status Explanations</a>
    </nav>

    <div id="status-popup" style="display:none; position: fixed; top: 60px; right: 20px; background: white; border: 1px solid #ccc; padding: 20px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); z-index: 1000; width: 400px; border-radius: 4px;">
        <h3 style="margin-top: 0;">Status Explanations</h3>
        <ul style="list-style: none; padding: 0;">
            {foreach App\Utils\ExplanationUtils::getStatusExplanations() as $item}
            <li n:class="'status-' . $item->color" style="margin-bottom: 10px; display: flex; align-items: center;">
                <span class="pill" style="width: 80px; text-align: center; margin-right: 10px;">{$item->name}</span>
                <span>{$item->description}</span>
            </li>
            {/foreach}
        </ul>
    </div>

    <script>
        function toggleStatusPopup(e) {
            e.preventDefault();
            var popup = document.getElementById('status-popup');
            if (popup.style.display === 'none') {
                popup.style.display = 'block';
            } else {
                popup.style.display = 'none';
            }
        }
    </script>

    <main class="content">
        <div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>
        {include content}
    </main>

    <!-- Full image modal -->
    <div id="imageModal" class="image-modal" onclick="hideFullImage()">
        <img id="modalImage" src="" alt="Full size image">
    </div>

	{block scripts}
	<script src="https://unpkg.com/nette-forms@3"></script>
	{/block}
</body>
</html>